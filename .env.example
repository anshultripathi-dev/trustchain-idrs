# sim    = fully simulated home (no hardware needed)
# hybrid = real ESP32 #1 telemetry + real ESP32 #2 alarm, other devices simulated
TRUSTCHAIN_MODE=sim
# full = the 38-device, 10-room smart home (default)   core = just the 5 original devices
TRUSTCHAIN_HOME=full
ESP32_SMART_HOME_IP=
ESP32_SECURITY_IP=
TRUSTCHAIN_HOST=127.0.0.1
TRUSTCHAIN_PORT=8000
TRUSTCHAIN_ADMIN_TOKEN=admin
